# ===========================================
# 环境变量配置 (可选)
# ===========================================
# 环境变量优先级高于 settings.toml 和 .secrets.toml
# 命名规则: EOE_前缀 + 大写配置名
#
# 例如:
#   settings.toml 中的 app_name -> EOE_APP_NAME
#   settings.toml 中的 database_url -> EOE_DATABASE_URL
#   settings.toml 中的 jwt_expire_days -> EOE_JWT_EXPIRE_DAYS
# ===========================================

# 当前环境: development | testing | production
EOE_ENV=development

# 应用配置
EOE_DEBUG=true
EOE_APP_NAME="EOE演讲线上助手 Backend Dev"

# 安全密钥 (生产环境强烈建议通过环境变量设置)
# EOE_SECRET_KEY=your-secret-key-here
# EOE_JWT_SECRET_KEY=your-jwt-secret-key-here

# 微信小程序配置 (也可在 .secrets.toml 中配置)
# EOE_WECHAT_APPID=wx1234567890abcdef
# EOE_WECHAT_SECRET=your-wechat-secret

# 数据库配置
# 本地开发: SQLite
EOE_DATABASE_URL=sqlite:///./data/eoe.db

# 线上阿里云 MySQL (生产环境)
# EOE_DATABASE_URL=mysql+aiomysql://username:password@your-rds-endpoint:3306/eoe_db

# JWT 配置
EOE_JWT_EXPIRE_DAYS=7
