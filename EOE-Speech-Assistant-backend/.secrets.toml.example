# ===========================================
# 敏感信息配置文件
# 复制此文件为 .secrets.toml 并填入真实值
# .secrets.toml 已在 .gitignore 中，不会提交到 Git
# ===========================================

# 默认环境的敏感配置
[default]
# 应用密钥 (至少 32 位随机字符串)
secret_key = "change-this-to-a-random-secret-key-min-32-chars"

# JWT 密钥 (至少 32 位随机字符串)
jwt_secret_key = "change-this-to-another-random-secret-key-min-32-chars"

# 微信小程序配置
wechat_appid = "wx1234567890abcdef"
wechat_secret = "your-wechat-app-secret-here"


# ===========================================
# 开发环境敏感配置
# ===========================================
[development]
secret_key = "dev-secret-key-change-in-production-32chars"
jwt_secret_key = "dev-jwt-secret-key-change-in-production-32chars"

wechat_appid = "wx-dev-appid"
wechat_secret = "wx-dev-secret"


# ===========================================
# 生产环境敏感配置 (重要!)
# ===========================================
[production]
# 生产环境必须使用强密钥！
secret_key = "production-secret-key-minimum-32-characters-long"
jwt_secret_key = "production-jwt-secret-key-min-32-characters"

# 微信小程序生产配置
wechat_appid = "wx-your-production-appid"
wechat_secret = "your-production-app-secret"

# 阿里云 MySQL 配置 (生产环境)
# database_url = "mysql+aiomysql://username:password@your-rds-endpoint:3306/eoe_db"
