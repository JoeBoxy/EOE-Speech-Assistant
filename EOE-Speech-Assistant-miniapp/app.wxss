/* Claude Design System - Warm Parchment Theme */

page {
  /* Primary */
  --near-black: #141413;
  --terracotta: #c96442;
  --coral: #d97757;

  /* Surfaces */
  --parchment: #f5f4ed;
  --ivory: #faf9f5;
  --pure-white: #ffffff;
  --warm-sand: #e8e6dc;
  --dark-surface: #30302e;
  --deep-dark: #141413;

  /* Text */
  --charcoal: #4d4c48;
  --olive-gray: #5e5d59;
  --stone-gray: #87867f;
  --dark-warm: #3d3d3a;
  --warm-silver: #b0aea5;

  /* Borders & Rings */
  --border-cream: #f0eee6;
  --border-warm: #e8e6dc;
  --border-dark: #30302e;
  --ring-warm: #d1cfc5;
  --ring-subtle: #dedcd1;
  --ring-deep: #c2c0b6;

  /* Semantic */
  --error-crimson: #b53333;
  --focus-blue: #3898ec;
  --success: #5a7c5a;

  /* Alias for compatibility */
  --primary: var(--terracotta);
  --primary-light: rgba(201, 100, 66, 0.08);
  --background: var(--parchment);
  --surface: var(--ivory);
  --text-primary: var(--near-black);
  --text-secondary: var(--olive-gray);
  --text-tertiary: var(--stone-gray);
  --border: var(--border-cream);
  --border-light: var(--border-warm);

  background-color: var(--parchment);
  color: var(--near-black);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.6;
}

/* Serif for headlines */
.serif {
  font-family: Georgia, 'Times New Roman', serif;
  font-weight: 500;
}

view, scroll-view, swiper, button, input, textarea, label, navigator, image {
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--parchment);
}

/* ===== Utility Classes ===== */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.grow { flex-grow: 1; }
.shrink-0 { flex-shrink: 0; }
.w-full { width: 100%; }
.h-full { height: 100%; }
.relative { position: relative; }
.absolute { position: absolute; }
.text-center { text-align: center; }
.font-bold { font-weight: 600; }

/* Text sizes */
.text-xs { font-size: 22rpx; }
.text-sm { font-size: 24rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-2xl { font-size: 40rpx; }
.text-3xl { font-size: 52rpx; }

/* Text colors */
.text-near-black { color: var(--near-black); }
.text-charcoal { color: var(--charcoal); }
.text-olive { color: var(--olive-gray); }
.text-stone { color: var(--stone-gray); }
.text-warm-silver { color: var(--warm-silver); }
.text-terracotta { color: var(--terracotta); }
.text-coral { color: var(--coral); }

/* Backgrounds */
.bg-parchment { background-color: var(--parchment); }
.bg-ivory { background-color: var(--ivory); }
.bg-white { background-color: var(--pure-white); }
.bg-warm-sand { background-color: var(--warm-sand); }
.bg-dark { background-color: var(--dark-surface); }
.bg-deep-dark { background-color: var(--deep-dark); }
.bg-terracotta { background-color: var(--terracotta); }

/* Border radius */
.rounded-sm { border-radius: 8rpx; }
.rounded { border-radius: 16rpx; }
.rounded-lg { border-radius: 24rpx; }
.rounded-xl { border-radius: 32rpx; }
.rounded-full { border-radius: 9999px; }

/* ===== Components ===== */

/* Card - Ivory on Parchment */
.card {
  background: var(--ivory);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-cream);
}

/* Card with whisper shadow */
.card-elevated {
  background: var(--ivory);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: rgba(0,0,0,0.04) 0rpx 2rpx 16rpx;
}

/* Section card with top border */
.section-card {
  background: var(--ivory);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  border-top: 1rpx solid var(--border-warm);
}

/* ===== Buttons ===== */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  line-height: 1;
}

/* Primary CTA - Terracotta */
.btn-primary {
  background: var(--terracotta);
  color: var(--ivory);
  box-shadow: 0rpx 0rpx 0rpx 1rpx rgba(201, 100, 66, 0.3);
}

/* Secondary - Warm Sand */
.btn-secondary {
  background: var(--warm-sand);
  color: var(--charcoal);
  box-shadow: 0rpx 0rpx 0rpx 1rpx var(--ring-warm);
}

/* Dark Charcoal */
.btn-dark {
  background: var(--dark-surface);
  color: var(--ivory);
  box-shadow: 0rpx 0rpx 0rpx 1rpx var(--border-dark);
}

/* Outline on light */
.btn-outline {
  background: var(--ivory);
  color: var(--near-black);
  border: 1rpx solid var(--border-cream);
  box-shadow: 0rpx 0rpx 0rpx 1rpx var(--border-cream);
}

.btn-sm {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
}

/* ===== Tags ===== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.4;
}

.tag-primary {
  background: rgba(201, 100, 66, 0.1);
  color: var(--terracotta);
}

.tag-secondary {
  background: var(--warm-sand);
  color: var(--charcoal);
}

.tag-dark {
  background: var(--dark-surface);
  color: var(--warm-silver);
}

/* ===== Dividers ===== */
.divider {
  height: 1rpx;
  background: var(--border-cream);
}

.divider-warm {
  height: 1rpx;
  background: var(--border-warm);
}

/* ===== Safe Area ===== */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== Dark Section ===== */
.dark-section {
  background: var(--deep-dark);
  color: var(--ivory);
}

.dark-section .section-title {
  color: var(--ivory);
}
