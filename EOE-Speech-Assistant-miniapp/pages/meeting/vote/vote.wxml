<view class="container">
  <view class="vote-header">
    <view class="vote-title">🏆 现场投票</view>
    <view class="vote-status {{voteOpen ? 'open' : 'closed'}}">
      {{voteOpen ? '投票进行中' : '投票未开始'}}
    </view>
  </view>

  <!-- Admin Controls -->
  <view class="admin-bar" wx:if="{{isAdmin}}">
    <button class="btn btn-sm {{voteOpen ? 'btn-outline' : 'btn-primary'}}" bindtap="onToggleVote">
      {{voteOpen ? '关闭投票' : '开启投票'}}
    </button>
    <button class="btn btn-sm btn-outline" bindtap="onShowResults">查看结果</button>
  </view>

  <!-- Best Speaker -->
  <view class="vote-section">
    <view class="vote-section-title">最佳演讲 Best Speaker</view>
    <view class="candidate-list">
      <view 
        class="candidate-card {{myVotes.bestSpeaker === item.id ? 'selected' : ''}}"
        wx:for="{{candidates.bestSpeaker}}"
        wx:key="id"
        data-category="bestSpeaker"
        data-id="{{item.id}}"
        bindtap="onCandidateTap"
      >
        <view class="candidate-avatar">{{item.name[0]}}</view>
        <view class="candidate-info">
          <text class="candidate-name">{{item.name}}</text>
          <text class="candidate-title">{{item.title}}</text>
        </view>
        <view class="candidate-votes" wx:if="{{hasVoted}}">
          <text class="vote-num">{{item.votes}}票</text>
        </view>
        <view class="check-icon" wx:if="{{myVotes.bestSpeaker === item.id}}">✓</view>
      </view>
    </view>
  </view>

  <!-- Best Evaluator -->
  <view class="vote-section">
    <view class="vote-section-title">最佳点评 Best Evaluator</view>
    <view class="candidate-list">
      <view 
        class="candidate-card {{myVotes.bestEvaluator === item.id ? 'selected' : ''}}"
        wx:for="{{candidates.bestEvaluator}}"
        wx:key="id"
        data-category="bestEvaluator"
        data-id="{{item.id}}"
        bindtap="onCandidateTap"
      >
        <view class="candidate-avatar">{{item.name[0]}}</view>
        <view class="candidate-info">
          <text class="candidate-name">{{item.name}}</text>
          <text class="candidate-title">{{item.title}}</text>
        </view>
        <view class="candidate-votes" wx:if="{{hasVoted}}">
          <text class="vote-num">{{item.votes}}票</text>
        </view>
        <view class="check-icon" wx:if="{{myVotes.bestEvaluator === item.id}}">✓</view>
      </view>
    </view>
  </view>

  <!-- Best Table Topics -->
  <view class="vote-section">
    <view class="vote-section-title">最佳即兴 Best Table Topics</view>
    <view class="candidate-list">
      <view 
        class="candidate-card {{myVotes.bestTableTopics === item.id ? 'selected' : ''}}"
        wx:for="{{candidates.bestTableTopics}}"
        wx:key="id"
        data-category="bestTableTopics"
        data-id="{{item.id}}"
        bindtap="onCandidateTap"
      >
        <view class="candidate-avatar">{{item.name[0]}}</view>
        <view class="candidate-info">
          <text class="candidate-name">{{item.name}}</text>
          <text class="candidate-title" wx:if="{{item.isGuest}}">嘉宾</text>
        </view>
        <view class="candidate-votes" wx:if="{{hasVoted}}">
          <text class="vote-num">{{item.votes}}票</text>
        </view>
        <view class="check-icon" wx:if="{{myVotes.bestTableTopics === item.id}}">✓</view>
      </view>
    </view>
  </view>

  <!-- Submit -->
  <view class="submit-bar" wx:if="{{!hasVoted && voteOpen}}">
    <button class="btn btn-primary w-full" bindtap="onSubmitVote">提交投票</button>
  </view>

  <view class="submit-bar" wx:if="{{hasVoted}}">
    <view class="voted-tip">✅ 您已完成投票</view>
  </view>
</view>
