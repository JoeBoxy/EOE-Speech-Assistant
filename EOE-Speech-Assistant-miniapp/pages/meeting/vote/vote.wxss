/* Claude Warm Theme - Vote Page */

.container {
  background-color: var(--parchment);
  padding-bottom: 120rpx;
}

.vote-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background: var(--deep-dark);
  color: var(--ivory);
}

.vote-title {
  font-family: Georgia, serif;
  font-size: 36rpx;
  font-weight: 500;
}

.vote-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  background: var(--dark-surface);
  color: var(--warm-silver);
  border: 1rpx solid var(--border-dark);
}

.vote-status.open {
  background: rgba(90, 124, 90, 0.2);
  color: #7a9e7a;
  border-color: rgba(90, 124, 90, 0.3);
}

.admin-bar {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: var(--ivory);
  border-bottom: 1rpx solid var(--border-cream);
}

.vote-section {
  padding: 24rpx 32rpx;
}

.vote-section-title {
  font-family: Georgia, serif;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--near-black);
  margin-bottom: 20rpx;
}

.candidate-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.candidate-card {
  display: flex;
  align-items: center;
  background: var(--ivory);
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid var(--border-cream);
  position: relative;
}

.candidate-card.selected {
  border-color: var(--terracotta);
  background: rgba(201, 100, 66, 0.04);
  box-shadow: 0rpx 0rpx 0rpx 1rpx rgba(201, 100, 66, 0.2);
}

.candidate-avatar {
  width: 72rpx;
  height: 72rpx;
  background: var(--warm-sand);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--charcoal);
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.candidate-info {
  flex: 1;
}

.candidate-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--near-black);
  display: block;
}

.candidate-title {
  font-size: 24rpx;
  color: var(--olive-gray);
}

.candidate-votes {
  text-align: right;
}

.vote-num {
  font-family: Georgia, serif;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--terracotta);
}

.check-icon {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 40rpx;
  height: 40rpx;
  background: var(--terracotta);
  border-radius: 50%;
  color: var(--ivory);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.submit-bar {
  padding: 24rpx 32rpx 48rpx;
  background: var(--ivory);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  border-top: 1rpx solid var(--border-cream);
}

.voted-tip {
  text-align: center;
  color: var(--success);
  font-size: 28rpx;
  font-weight: 500;
  padding: 24rpx;
}
