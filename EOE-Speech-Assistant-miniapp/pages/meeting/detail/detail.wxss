.container {
  background-color: var(--parchment);
  min-height: 100vh;
}

/* ===== Meeting Hero (活动详情) ===== */
.meeting-hero {
  background: var(--deep-dark);
  padding: 48rpx 32rpx;
  color: var(--ivory);
  margin-bottom: 24rpx;
  position: relative;
}

.meeting-status-tag {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

.meeting-status-tag.preparing {
  background: rgba(201, 100, 66, 0.2);
  color: #d97757;
}

.meeting-status-tag.finished {
  background: var(--dark-surface);
  color: var(--warm-silver);
}

.meeting-theme-large {
  font-family: Georgia, serif;
  font-size: 44rpx;
  font-weight: 500;
  line-height: 1.3;
  margin-bottom: 16rpx;
  padding-right: 120rpx;
}

.meeting-form {
  font-size: 26rpx;
  color: var(--warm-silver);
  margin-bottom: 24rpx;
}

.meeting-meta-bar {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.meeting-meta-bar .meta-item {
  font-size: 26rpx;
  color: var(--warm-silver);
}

.club-info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.club-badge {
  width: 44rpx;
  height: 44rpx;
  background: var(--dark-surface);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--warm-silver);
  border: 1rpx solid var(--border-dark);
}

.club-name {
  font-size: 26rpx;
  color: var(--warm-silver);
}

.join-btn {
  width: 60%;
  margin: 0 auto;
  background: var(--terracotta);
  color: var(--ivory);
  border: none;
  font-weight: 500;
}

/* ===== Club Hero ===== */
.club-hero {
  background: var(--deep-dark);
  padding: 48rpx 32rpx;
  text-align: center;
  color: var(--ivory);
  margin-bottom: 24rpx;
}

.club-logo-large {
  width: 120rpx;
  height: 120rpx;
  background: var(--dark-surface);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  font-family: Georgia, serif;
  font-size: 48rpx;
  font-weight: 500;
  color: var(--warm-silver);
  border: 2rpx solid var(--border-dark);
}

.club-name-large {
  font-family: Georgia, serif;
  font-size: 40rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
  line-height: 1.2;
}

.club-slogan {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 24rpx;
  color: var(--warm-silver);
}

.club-meta-bar {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
  flex-wrap: wrap;
}

.club-meta-bar .meta-item {
  font-size: 24rpx;
  opacity: 0.85;
  color: var(--warm-silver);
}

/* ===== Section Card ===== */
.section-card {
  background: var(--ivory);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  border: 1rpx solid var(--border-cream);
}

.section-title {
  font-family: Georgia, serif;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--near-black);
  margin-bottom: 20rpx;
}

.desc-text {
  font-size: 28rpx;
  color: var(--olive-gray);
  line-height: 1.7;
}

/* ===== Role Preview ===== */
.role-preview-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.role-preview-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-cream);
}

.role-preview-item:last-child {
  border-bottom: none;
}

.role-name {
  font-size: 28rpx;
  color: var(--near-black);
  font-weight: 500;
}

.role-person {
  font-size: 26rpx;
  color: var(--olive-gray);
}

/* ===== Officer List ===== */
.officer-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.officer-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(25% - 15rpx);
}

.officer-avatar {
  width: 72rpx;
  height: 72rpx;
  background: var(--warm-sand);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--charcoal);
  font-family: Georgia, serif;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.officer-role {
  font-size: 20rpx;
  color: var(--stone-gray);
}

.officer-name {
  font-size: 24rpx;
  color: var(--near-black);
  font-weight: 500;
}

/* ===== History ===== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.view-all {
  font-size: 24rpx;
  color: var(--terracotta);
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-cream);
}

.history-item:last-child {
  border-bottom: none;
}

.history-theme {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--near-black);
  display: block;
  margin-bottom: 4rpx;
}

.history-date {
  font-size: 24rpx;
  color: var(--olive-gray);
}

.history-arrow {
  font-size: 32rpx;
  color: var(--stone-gray);
}
