<view class="container">
  <!-- Meeting Detail View -->
  <block wx:if="{{type === 'meeting' && meeting}}">
    <view class="meeting-hero">
      <view class="meeting-status-tag {{meeting.status === 'preparing' ? 'preparing' : 'finished'}}">
        {{meeting.status === 'preparing' ? '报名中' : '已结束'}}
      </view>
      <view class="meeting-theme-large">{{meeting.theme}}</view>
      <view class="meeting-form">{{meeting.form}}</view>
      <view class="meeting-meta-bar">
        <text class="meta-item">📅 {{meeting.date}} {{meeting.time}}</text>
        <text class="meta-item" wx:if="{{meeting.location}}">📍 {{meeting.location}}</text>
      </view>
      <view class="club-info-row" wx:if="{{club}}">
        <view class="club-badge">{{club.name[0]}}</view>
        <text class="club-name">{{club.name}}</text>
      </view>
      <button class="btn btn-primary join-btn" bindtap="onRegisterTap" wx:if="{{meeting.status === 'preparing'}}">立即报名</button>
    </view>

    <!-- Roles Preview -->
    <view class="section-card" wx:if="{{meeting.registrations && meeting.registrations.length > 0}}">
      <view class="section-title">已报名角色</view>
      <view class="role-preview-list">
        <view class="role-preview-item" wx:for="{{meeting.registrations}}" wx:key="id">
          <text class="role-name">{{item.role}}</text>
          <text class="role-person">{{item.guestName || '会员'}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- Club Detail View -->
  <block wx:if="{{type === 'club' && club}}">
    <view class="club-hero">
      <view class="club-logo-large">{{club.name[0]}}</view>
      <view class="club-name-large">{{club.name}}</view>
      <view class="club-slogan">{{club.slogan}}</view>
      <view class="club-meta-bar">
        <text class="meta-item">📍 {{club.city}}·{{club.district}}</text>
        <text class="meta-item">⏰ {{club.meetingTime}}</text>
        <text class="meta-item">👥 {{club.memberCount}}人</text>
      </view>
      <button class="btn btn-primary join-btn" bindtap="onRegisterTap">报名本期例会</button>
    </view>

    <view class="section-card">
      <view class="section-title">关于我们</view>
      <text class="desc-text">{{club.description}}</text>
    </view>

    <view class="section-card" wx:if="{{club.officerTeam}}">
      <view class="section-title">官员团队</view>
      <view class="officer-list">
        <view class="officer-item" wx:for="{{club.officerTeam}}" wx:key="role">
          <view class="officer-avatar">{{item.name[0]}}</view>
          <text class="officer-role">{{item.role}}</text>
          <text class="officer-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-header">
        <text class="section-title">往期例会</text>
        <text class="view-all">查看全部 ›</text>
      </view>
      <view class="history-list">
        <view class="history-item" wx:for="{{meetings}}" wx:key="id" data-id="{{item.id}}" bindtap="onMeetingTap">
          <view class="history-info">
            <text class="history-theme">{{item.theme}}</text>
            <text class="history-date">{{item.date}} · {{item.form}}</text>
          </view>
          <text class="history-arrow">›</text>
        </view>
      </view>
    </view>
  </block>
</view>
