/* Claude Warm Theme - Timer Page */

.container {
  background-color: var(--parchment);
}

.speaker-selector {
  padding: 24rpx 32rpx;
  background: var(--ivory);
  border-bottom: 1rpx solid var(--border-cream);
}

.selector-title {
  font-family: Georgia, serif;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
  color: var(--near-black);
}

.speaker-list {
  white-space: nowrap;
}

.speaker-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 32rpx;
  background: var(--parchment);
  border-radius: 16rpx;
  margin-right: 16rpx;
  min-width: 140rpx;
  border: 1rpx solid var(--border-cream);
}

.speaker-chip.active {
  background: rgba(201, 100, 66, 0.08);
  border-color: var(--terracotta);
  box-shadow: 0rpx 0rpx 0rpx 1rpx rgba(201, 100, 66, 0.15);
}

.chip-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--near-black);
}

.chip-title {
  font-size: 20rpx;
  color: var(--olive-gray);
}

.timer-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 32rpx;
  margin: 32rpx;
  background: var(--ivory);
  border-radius: 32rpx;
  min-height: 400rpx;
  border: 1rpx solid var(--border-cream);
}

.timer-display.green {
  border-color: rgba(90, 124, 90, 0.4);
}

.timer-display.yellow {
  border-color: rgba(217, 119, 87, 0.4);
}

.timer-display.red {
  border-color: rgba(181, 51, 51, 0.4);
}

.timer-display.overtime {
  border-color: var(--error-crimson);
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.75; }
}

.timer-speaker {
  font-size: 28rpx;
  color: var(--olive-gray);
  margin-bottom: 16rpx;
}

.timer-time {
  font-family: Georgia, serif;
  font-size: 96rpx;
  font-weight: 500;
  color: var(--near-black);
  margin-bottom: 16rpx;
  line-height: 1;
}

.timer-target {
  font-size: 24rpx;
  color: var(--stone-gray);
  margin-bottom: 32rpx;
}

.timer-zones {
  display: flex;
  gap: 24rpx;
}

.zone {
  font-size: 40rpx;
  transition: opacity 0.3s;
}

.zone.dim {
  opacity: 0.25;
}

.timer-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
  margin: 32rpx;
  background: var(--ivory);
  border-radius: 32rpx;
  border: 1rpx dashed var(--border-warm);
}

.placeholder-text {
  font-size: 28rpx;
  color: var(--stone-gray);
}

.timer-controls {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding: 0 32rpx 32rpx;
}

.btn-danger {
  background: var(--error-crimson);
  color: var(--ivory);
}

.btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.records-section {
  padding: 0 32rpx 48rpx;
}

.records-title {
  font-family: Georgia, serif;
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
  color: var(--near-black);
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--ivory);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--border-cream);
}

.record-info {
  display: flex;
  flex-direction: column;
}

.record-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--near-black);
}

.record-title {
  font-size: 22rpx;
  color: var(--olive-gray);
}

.record-duration {
  font-family: Georgia, serif;
  font-size: 36rpx;
  font-weight: 500;
  color: var(--success);
}

.record-duration.overtime {
  color: var(--error-crimson);
}
