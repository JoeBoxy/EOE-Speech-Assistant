/* Claude Warm Theme - Meeting Page */

.container {
  background-color: var(--parchment);
}

.meeting-card {
  background: var(--deep-dark);
  border-radius: 0 0 32rpx 32rpx;
  padding: 40rpx 32rpx;
  color: var(--ivory);
  margin-bottom: 24rpx;
}

.meeting-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.meeting-theme {
  font-family: Georgia, serif;
  font-size: 40rpx;
  font-weight: 500;
  flex: 1;
  line-height: 1.2;
}

.meeting-form {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.tag-primary {
  background: rgba(255,255,255,0.12);
  color: var(--ivory);
}

.meeting-info {
  margin-bottom: 32rpx;
}

.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  opacity: 0.85;
}

.info-icon {
  margin-right: 12rpx;
  font-size: 24rpx;
}

.info-text {
  font-size: 26rpx;
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  background: var(--dark-surface);
  border-radius: 20rpx;
  padding: 24rpx 0;
  border: 1rpx solid var(--border-dark);
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.action-label {
  font-size: 24rpx;
  opacity: 0.85;
  color: var(--warm-silver);
}

.section {
  padding: 0 32rpx 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-family: Georgia, serif;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--near-black);
}

.section-sub {
  font-size: 24rpx;
  color: var(--stone-gray);
}

.role-grid {
  margin-bottom: 24rpx;
}

.role-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.role-cell {
  flex: 1;
  background: var(--ivory);
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  min-height: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--border-cream);
}

.role-cell.empty {
  border: 1rpx dashed var(--border-warm);
  background: transparent;
}

.role-cell.occupied {
  background: var(--parchment);
  border-color: var(--border-warm);
}

.role-label {
  font-size: 22rpx;
  color: var(--stone-gray);
  margin-bottom: 8rpx;
}

.role-avatar {
  width: 56rpx;
  height: 56rpx;
  background: var(--terracotta);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ivory);
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.role-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--near-black);
}

.role-title {
  font-size: 20rpx;
  color: var(--olive-gray);
  margin-top: 4rpx;
}

.role-status {
  font-size: 24rpx;
  color: var(--stone-gray);
}

.table-topics-area {
  background: var(--ivory);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid var(--border-cream);
}

.tt-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.tt-title {
  font-family: Georgia, serif;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--near-black);
}

.tt-count {
  font-size: 24rpx;
  color: var(--stone-gray);
}

.tt-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tt-item {
  display: flex;
  align-items: center;
  background: var(--parchment);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--border-cream);
}

.tt-avatar {
  width: 40rpx;
  height: 40rpx;
  background: var(--terracotta);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ivory);
  font-size: 20rpx;
  margin-right: 12rpx;
}

.tt-name {
  font-size: 26rpx;
  color: var(--near-black);
  margin-right: 8rpx;
}

.tt-tag {
  font-size: 18rpx;
  color: var(--terracotta);
  background: rgba(201, 100, 66, 0.1);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.loading-tip, .empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: var(--stone-gray);
  font-size: 28rpx;
}
