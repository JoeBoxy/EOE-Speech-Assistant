.container {
  background-color: var(--parchment);
  padding-bottom: 48rpx;
}

.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 32rpx;
  background: var(--deep-dark);
  margin-bottom: 24rpx;
}

.stat-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-family: Georgia, serif;
  font-size: 36rpx;
  font-weight: 500;
  color: var(--ivory);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--warm-silver);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--border-dark);
}

.timer-panel {
  background: var(--ivory);
  border-radius: 24rpx;
  padding: 40rpx;
  margin: 0 32rpx 24rpx;
  border: 1rpx solid var(--border-cream);
  text-align: center;
}

.timer-label {
  font-size: 24rpx;
  color: var(--stone-gray);
  margin-bottom: 12rpx;
}

.timer-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--near-black);
  margin-bottom: 20rpx;
}

.timer-display {
  font-family: Georgia, serif;
  font-size: 72rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
  line-height: 1;
}

.timer-target {
  font-size: 24rpx;
  color: var(--stone-gray);
  margin-bottom: 24rpx;
}

.timer-bar {
  height: 12rpx;
  background: var(--border-cream);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.timer-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.timer-actions {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.agenda-section {
  padding: 0 32rpx;
}

.agenda-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-family: Georgia, serif;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--near-black);
}

.agenda-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.agenda-item {
  display: flex;
  align-items: center;
  background: var(--ivory);
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid var(--border-cream);
  transition: all 0.2s;
}

.agenda-item.active {
  border-color: var(--terracotta);
  box-shadow: 0rpx 0rpx 0rpx 1rpx rgba(201, 100, 66, 0.15);
}

.agenda-item.completed {
  opacity: 0.6;
  background: var(--parchment);
}

.agenda-index {
  width: 48rpx;
  height: 48rpx;
  background: var(--warm-sand);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--charcoal);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.agenda-item.active .agenda-index {
  background: var(--terracotta);
  color: var(--ivory);
}

.agenda-info {
  flex: 1;
}

.agenda-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--near-black);
  display: block;
}

.agenda-speaker {
  font-size: 24rpx;
  color: var(--olive-gray);
  margin-top: 4rpx;
}

.agenda-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.agenda-duration {
  font-size: 24rpx;
  color: var(--stone-gray);
}

.agenda-status {
  font-size: 28rpx;
  color: var(--success);
}

.agenda-status.pending {
  color: var(--terracotta);
}
