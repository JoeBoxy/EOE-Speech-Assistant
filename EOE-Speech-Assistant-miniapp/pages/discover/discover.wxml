<view class="container">
  <!-- Header -->
  <view class="header">
    <view class="header-title">
      <text class="title-main">活动广场</text>
      <text class="title-sub">发现精彩演讲活动</text>
    </view>
    <view class="search-bar" bindtap="onSearch">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索活动主题</text>
    </view>
  </view>

  <!-- Tabs -->
  <view class="tab-bar">
    <view 
      class="tab-item {{activeTab === 'upcoming' ? 'active' : ''}}"
      data-tab="upcoming"
      bindtap="onTabTap"
    >
      <text class="tab-text">即将开始</text>
    </view>
    <view 
      class="tab-item {{activeTab === 'past' ? 'active' : ''}}"
      data-tab="past"
      bindtap="onTabTap"
    >
      <text class="tab-text">精彩回顾</text>
    </view>
  </view>

  <!-- Meeting List -->
  <scroll-view 
    class="meeting-list" 
    scroll-y 
    refresher-enabled 
    refresher-triggered="{{loading}}"
    bindrefresherrefresh="loadMeetings"
  >
    <view wx:if="{{loading && meetings.length === 0}}" class="loading-tip">
      <text>加载活动中...</text>
    </view>
    
    <view wx:if="{{!loading && meetings.length === 0}}" class="empty-tip">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂{{activeTab === 'upcoming' ? '无即将开始' : '无历史回顾'}}的活动</text>
    </view>
    
    <view 
      class="meeting-card" 
      wx:for="{{meetings}}" 
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onMeetingTap"
    >
      <!-- Status Tag -->
      <view class="meeting-status-tag {{item.status === 'preparing' ? 'preparing' : 'finished'}}">
        {{item.status === 'preparing' ? '报名中' : '已结束'}}
      </view>
      
      <!-- Theme -->
      <view class="meeting-theme">{{item.theme}}</view>
      
      <!-- Club Info -->
      <view class="club-info-row">
        <view class="club-badge">{{item.clubName[0]}}</view>
        <text class="club-name">{{item.clubName}}</text>
        <text class="club-location" wx:if="{{item.clubCity}}">{{item.clubCity}}·{{item.clubDistrict}}</text>
      </view>
      
      <!-- Meta -->
      <view class="meeting-meta">
        <view class="meta-item">
          <text class="meta-icon">📅</text>
          <text class="meta-text">{{item.date}} {{item.time}}</text>
        </view>
        <view class="meta-item" wx:if="{{item.location}}">
          <text class="meta-icon">📍</text>
          <text class="meta-text">{{item.location}}</text>
        </view>
      </view>
      
      <!-- Form Tag -->
      <view class="meeting-tags">
        <text class="tag tag-secondary">{{item.form}}</text>
      </view>
      
      <!-- Action -->
      <view class="meeting-action" wx:if="{{item.status === 'preparing'}}">
        <button 
          class="btn btn-primary btn-sm" 
          catchtap="onRegisterTap"
          data-id="{{item.id}}"
        >立即报名</button>
      </view>
    </view>
  </scroll-view>
</view>
