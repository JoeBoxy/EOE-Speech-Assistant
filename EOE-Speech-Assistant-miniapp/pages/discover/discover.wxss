.container {
  background-color: var(--parchment);
  min-height: 100vh;
}

.header {
  padding: 40rpx 32rpx 24rpx;
  background: var(--deep-dark);
}

.header-title {
  margin-bottom: 24rpx;
}

.title-main {
  font-family: Georgia, serif;
  font-size: 44rpx;
  font-weight: 500;
  color: var(--ivory);
  display: block;
  line-height: 1.2;
}

.title-sub {
  font-size: 26rpx;
  color: var(--warm-silver);
  margin-top: 8rpx;
  display: block;
}

.search-bar {
  display: flex;
  align-items: center;
  background: var(--dark-surface);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--border-dark);
}

.search-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
  color: var(--warm-silver);
}

.search-placeholder {
  color: var(--warm-silver);
  font-size: 28rpx;
}

/* Tab Bar */
.tab-bar {
  display: flex;
  background: var(--ivory);
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--border-cream);
}

.tab-item {
  padding: 24rpx 0;
  margin-right: 40rpx;
  position: relative;
}

.tab-text {
  font-size: 30rpx;
  color: var(--stone-gray);
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: var(--near-black);
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--terracotta);
  border-radius: 2rpx;
}

/* Meeting List */
.meeting-list {
  padding: 24rpx 32rpx;
  flex: 1;
}

.meeting-card {
  background: var(--ivory);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-cream);
  box-shadow: rgba(0,0,0,0.03) 0rpx 2rpx 12rpx;
  position: relative;
}

.meeting-status-tag {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.meeting-status-tag.preparing {
  background: rgba(201, 100, 66, 0.1);
  color: var(--terracotta);
}

.meeting-status-tag.finished {
  background: var(--parchment);
  color: var(--stone-gray);
}

.meeting-theme {
  font-family: Georgia, serif;
  font-size: 36rpx;
  font-weight: 500;
  color: var(--near-black);
  margin-bottom: 20rpx;
  line-height: 1.3;
  padding-right: 100rpx;
}

.club-info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.club-badge {
  width: 40rpx;
  height: 40rpx;
  background: var(--warm-sand);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--charcoal);
  flex-shrink: 0;
}

.club-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--near-black);
}

.club-location {
  font-size: 22rpx;
  color: var(--stone-gray);
}

.meeting-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-icon {
  font-size: 22rpx;
}

.meta-text {
  font-size: 24rpx;
  color: var(--olive-gray);
}

.meeting-tags {
  margin-bottom: 20rpx;
}

.meeting-action {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-cream);
}

.loading-tip, .empty-tip {
  text-align: center;
  padding: 120rpx 0;
  color: var(--stone-gray);
}

.empty-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--stone-gray);
}
