<view class="container">
  <!-- User Profile -->
  <view class="profile-card">
    <block wx:if="{{isLoggedIn && userInfo}}">
      <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      <view class="profile-info">
        <text class="profile-name">{{userInfo.nickName}}</text>
        <text class="profile-id">EOE 会员</text>
      </view>
    </block>
    <block wx:else>
      <view class="avatar avatar-default">
        <text>?</text>
      </view>
      <view class="profile-info">
        <text class="profile-name">未登录</text>
        <button class="btn btn-sm btn-primary" bindtap="onLogin">微信登录</button>
      </view>
    </block>
  </view>

  <!-- My Clubs -->
  <view class="menu-section">
    <view class="menu-title">我的俱乐部</view>
    <view class="menu-list">
      <view 
        class="menu-item"
        wx:for="{{myClubs}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onClubTap"
      >
        <text class="menu-icon">🏠</text>
        <view class="menu-content">
          <text class="menu-label">{{item.name}}</text>
          <text class="menu-badge" wx:if="{{item.officerRole}}">{{item.officerRole}}</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- Menu -->
  <view class="menu-section">
    <view class="menu-title">功能</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="onSettingsTap">
        <text class="menu-icon">⚙️</text>
        <text class="menu-label">设置</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" wx:if="{{isOfficer}}" bindtap="onAdminTap">
        <text class="menu-icon">🔧</text>
        <text class="menu-label">官员后台</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onAboutTap">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-label">关于</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- Admin Shortcut (dev) -->
  <view class="dev-bar">
    <button class="btn btn-sm btn-outline" bindtap="onAdminTap">🛠 官员后台（开发）</button>
  </view>
</view>
