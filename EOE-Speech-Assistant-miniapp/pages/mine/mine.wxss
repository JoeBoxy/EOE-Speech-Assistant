/* Claude Warm Theme - Mine Page */

.container {
  background-color: var(--parchment);
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx;
  background: var(--deep-dark);
  margin-bottom: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 2rpx solid var(--border-dark);
}

.avatar-default {
  background: var(--dark-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--warm-silver);
  font-family: Georgia, serif;
  font-size: 48rpx;
  font-weight: 500;
}

.profile-info {
  color: var(--ivory);
}

.profile-name {
  font-family: Georgia, serif;
  font-size: 36rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.profile-id {
  font-size: 24rpx;
  color: var(--warm-silver);
}

.menu-section {
  padding: 0 32rpx 24rpx;
}

.menu-title {
  font-size: 22rpx;
  color: var(--stone-gray);
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.menu-list {
  background: var(--ivory);
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--border-cream);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--border-cream);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  width: 48rpx;
  text-align: center;
}

.menu-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.menu-label {
  font-size: 30rpx;
  color: var(--near-black);
}

.menu-badge {
  font-size: 20rpx;
  color: var(--terracotta);
  background: rgba(201, 100, 66, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--stone-gray);
  margin-left: 16rpx;
}

.dev-bar {
  padding: 48rpx 32rpx;
  text-align: center;
}
