<view class="container">
  <!-- Profile Header -->
  <view class="profile-header">
    <view class="profile-avatar">{{member.name[0]}}</view>
    <view class="profile-info">
      <view class="profile-name-row">
        <text class="profile-name">{{member.name}}</text>
        <text class="profile-en" wx:if="{{member.englishName}}">{{member.englishName}}</text>
      </view>
      <view class="profile-meta">
        <text class="tag tag-primary" wx:if="{{member.officerRole}}">{{member.officerRole}}</text>
        <text class="tag tag-secondary">{{member.region}}</text>
        <text class="tag tag-secondary">{{member.profession}}</text>
      </view>
      <text class="join-date">加入时间：{{member.memberSince}}</text>
    </view>
  </view>

  <!-- Stats Grid -->
  <view class="stats-grid">
    <view class="stat-card">
      <text class="stat-number">{{member.stats.totalSpeeches}}</text>
      <text class="stat-label">演讲次数</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">{{member.stats.bestSpeakerCount}}</text>
      <text class="stat-label">最佳演讲</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">{{member.stats.bestEvaluatorCount}}</text>
      <text class="stat-label">最佳点评</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">{{member.stats.avgDuration}}</text>
      <text class="stat-label">平均时长(分)</text>
    </view>
  </view>

  <!-- Role Distribution -->
  <view class="section-card">
    <view class="section-title">角色分布</view>
    <view class="role-bars">
      <view class="role-bar-item">
        <text class="role-bar-label">主持人</text>
        <view class="role-bar-track">
          <view class="role-bar-fill" style="width: {{member.stats.roleCounts.host * 10}}%"></view>
        </view>
        <text class="role-bar-count">{{member.stats.roleCounts.host}}</text>
      </view>
      <view class="role-bar-item">
        <text class="role-bar-label">备稿演讲</text>
        <view class="role-bar-track">
          <view class="role-bar-fill" style="width: 100%"></view>
        </view>
        <text class="role-bar-count">{{member.stats.roleCounts.preparedSpeaker}}</text>
      </view>
      <view class="role-bar-item">
        <text class="role-bar-label">点评</text>
        <view class="role-bar-track">
          <view class="role-bar-fill" style="width: {{member.stats.roleCounts.evaluator / member.stats.roleCounts.preparedSpeaker * 100}}%"></view>
        </view>
        <text class="role-bar-count">{{member.stats.roleCounts.evaluator}}</text>
      </view>
    </view>
  </view>

  <!-- Speech History -->
  <view class="section-card">
    <view class="section-title">演讲历史</view>
    <view class="speech-list">
      <view class="speech-item" wx:for="{{speeches}}" wx:key="index">
        <view class="speech-info">
          <text class="speech-theme">{{item.meetingTheme}}</text>
          <text class="speech-role">{{item.role}} · {{item.date}}</text>
        </view>
        <text class="speech-duration" wx:if="{{item.duration !== '-'}}">{{item.duration}}</text>
      </view>
    </view>
  </view>
</view>
