/* Claude Warm Theme - Profile Page */

.container {
  background-color: var(--parchment);
}

.profile-header {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx;
  background: var(--deep-dark);
  color: var(--ivory);
}

.profile-avatar {
  width: 140rpx;
  height: 140rpx;
  background: var(--dark-surface);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Georgia, serif;
  font-size: 56rpx;
  font-weight: 500;
  margin-right: 32rpx;
  border: 2rpx solid var(--border-dark);
  flex-shrink: 0;
  color: var(--warm-silver);
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.profile-name {
  font-family: Georgia, serif;
  font-size: 40rpx;
  font-weight: 500;
  color: var(--ivory);
}

.profile-en {
  font-size: 28rpx;
  color: var(--warm-silver);
}

.profile-meta {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.join-date {
  font-size: 24rpx;
  color: var(--warm-silver);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 24rpx 32rpx;
}

.stat-card {
  background: var(--ivory);
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  border: 1rpx solid var(--border-cream);
}

.stat-number {
  font-family: Georgia, serif;
  font-size: 40rpx;
  font-weight: 500;
  color: var(--terracotta);
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: var(--olive-gray);
}

.section-card {
  background: var(--ivory);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  border: 1rpx solid var(--border-cream);
}

.section-title {
  font-family: Georgia, serif;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--near-black);
  margin-bottom: 24rpx;
}

.role-bars {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.role-bar-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.role-bar-label {
  font-size: 26rpx;
  color: var(--olive-gray);
  width: 140rpx;
  flex-shrink: 0;
}

.role-bar-track {
  flex: 1;
  height: 16rpx;
  background: var(--parchment);
  border-radius: 8rpx;
  overflow: hidden;
  border: 1rpx solid var(--border-cream);
}

.role-bar-fill {
  height: 100%;
  background: var(--terracotta);
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.role-bar-count {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--near-black);
  width: 60rpx;
  text-align: right;
  flex-shrink: 0;
}

.speech-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.speech-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-cream);
}

.speech-item:last-child {
  border-bottom: none;
}

.speech-theme {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--near-black);
  display: block;
  margin-bottom: 4rpx;
}

.speech-role {
  font-size: 24rpx;
  color: var(--olive-gray);
}

.speech-duration {
  font-family: Georgia, serif;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--terracotta);
}
