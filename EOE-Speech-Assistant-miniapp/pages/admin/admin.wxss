/* Claude Warm Theme - Admin Page */

.container {
  background-color: var(--parchment);
}

.admin-header {
  padding: 32rpx;
  background: var(--deep-dark);
  color: var(--ivory);
  margin-bottom: 24rpx;
}

.admin-title {
  font-family: Georgia, serif;
  font-size: 36rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.admin-sub {
  font-size: 24rpx;
  color: var(--warm-silver);
}

.action-grid {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx 24rpx;
}

.action-card {
  flex: 1;
  background: var(--ivory);
  border-radius: 20rpx;
  padding: 32rpx 16rpx;
  text-align: center;
  border: 1rpx solid var(--border-cream);
  box-shadow: rgba(0,0,0,0.02) 0rpx 2rpx 8rpx;
}

.action-icon {
  font-size: 40rpx;
  display: block;
  margin-bottom: 12rpx;
}

.action-name {
  font-size: 26rpx;
  color: var(--near-black);
  font-weight: 500;
}

.section {
  padding: 0 32rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-family: Georgia, serif;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--near-black);
}

.meeting-list {
  background: var(--ivory);
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--border-cream);
}

.meeting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--border-cream);
}

.meeting-item:last-child {
  border-bottom: none;
}

.meeting-theme {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--near-black);
  display: block;
  margin-bottom: 4rpx;
}

.meeting-date {
  font-size: 24rpx;
  color: var(--olive-gray);
}

.meeting-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.meeting-status.preparing {
  background: rgba(201, 100, 66, 0.08);
  color: var(--terracotta);
}

.meeting-status.finished {
  background: var(--parchment);
  color: var(--stone-gray);
}
